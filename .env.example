# Database
DATABASE_URL=file:./dev.db

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# First deployment admin bootstrap
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-temporary-password
ADMIN_EMAILS=admin@example.com

# Admin API
ADMIN_API_KEY=replace-with-a-long-random-api-key

# Password reset email delivery via Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Flashcard Decks <noreply@example.com>
