# Database
DATABASE_URL=file:./dev.db

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# First deployment admin bootstrap (remove these after the first login)
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-temporary-password

# Admin API
ADMIN_API_KEY=replace-with-a-long-random-api-key

# Password reset email delivery via SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=ShuachCloud <your-email@example.com>
