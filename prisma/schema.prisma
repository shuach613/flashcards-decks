// This is your Prisma schema file,
// learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  role               String               @default("USER") // "ADMIN" | "USER"
  createdAt          DateTime             @default(now())
  studyProgress      StudyProgress[]
  cardProgress       CardProgress[]
  tracks             UserTrack[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  decks     Deck[]
  tracks    TrackCategory[]
}

model Track {
  id           String             @id @default(cuid())
  key          String             @unique
  name         String             @unique
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  users        UserTrack[]
  categories TrackCategory[]
}

model UserTrack {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
}

model TrackCategory {
  trackId       String
  track         Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([trackId, categoryId])
  @@index([categoryId])
}

model Deck {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  description   String          @default("")
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  language      String          @default("EN") // "EN" | "DE"
  createdAt     DateTime        @default(now())
  cards         Card[]
  studyProgress StudyProgress[]
}

model Card {
  id       String         @id @default(cuid())
  deckId   String
  deck     Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front    String
  back     String
  order    Int            @default(0)
  progress CardProgress[]
}

model CardProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  isGood     Boolean  @default(false)
  timesGood  Int      @default(0)
  timesAgain Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model StudyProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId        String
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lastStudiedAt DateTime @default(now())
  timesStudied  Int      @default(0)

  @@unique([userId, deckId])
}
