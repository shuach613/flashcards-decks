// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  role          String          @default("USER") // "ADMIN" | "USER"
  createdAt     DateTime        @default(now())
  studyProgress StudyProgress[]
  cardProgress  CardProgress[]
  tracks        UserTrack[]
}

model Certificate {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  decks     Deck[]
  tracks    TrackCertificate[]
}

model Track {
  id           String             @id @default(cuid())
  key          String             @unique
  name         String             @unique
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  users        UserTrack[]
  certificates TrackCertificate[]
}

model UserTrack {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
}

model TrackCertificate {
  trackId       String
  track         Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([trackId, certificateId])
  @@index([certificateId])
}

model Deck {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  description   String          @default("")
  certificateId String?
  certificate   Certificate?    @relation(fields: [certificateId], references: [id])
  language      String          @default("EN") // "EN" | "DE"
  createdAt     DateTime        @default(now())
  cards         Card[]
  studyProgress StudyProgress[]
}

model Card {
  id       String         @id @default(cuid())
  deckId   String
  deck     Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front    String
  back     String
  order    Int            @default(0)
  progress CardProgress[]
}

model CardProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  isGood     Boolean  @default(false)
  timesGood  Int      @default(0)
  timesAgain Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model StudyProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId        String
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lastStudiedAt DateTime @default(now())
  timesStudied  Int      @default(0)

  @@unique([userId, deckId])
}
